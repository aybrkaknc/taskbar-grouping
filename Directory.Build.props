<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Without this the compiler never emits CS1591 at all, so the
         dotnet_diagnostic.CS1591.severity setting in .editorconfig had nothing to
         elevate and the documented "XML docs on every public member" rule was
         enforced by nobody. On by default so a new src project is covered without
         anyone remembering; the test projects opt out, where xUnit's public test
         classes would otherwise demand 300+ comments that document nothing. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.5.0</Version>
    <Authors>Gian Luca Schwekendiek</Authors>
    <Product>TaskbarFolders</Product>
    <Copyright>Copyright (c) 2026 Gian Luca Schwekendiek</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- embedded, not none: coverlet needs debug information to map IL back to source, and
         with none the CI coverage report was silently empty for every run since the pipeline
         was built. Embedding it keeps that working without producing separate .pdb files that
         would then have to be excluded from the published artifacts. -->
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
