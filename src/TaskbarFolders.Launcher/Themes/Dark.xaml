<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- See Light.xaml for when the fallback panel is used. -->
    <SolidColorBrush x:Key="PopupFallbackBackground" Color="#E6202020" />
    <SolidColorBrush x:Key="ForegroundDefault" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ForegroundSubtle" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TileHoverBackground" Color="#1F4CC2FF" />
    <SolidColorBrush x:Key="ErrorBackdropBrush" Color="#CC202020" />
    <!-- The failure strip paints on a fixed dark red plate in both themes, so its text
         cannot use ForegroundDefault - that would be near-black on dark red in Light. -->
    <SolidColorBrush x:Key="ErrorForeground" Color="#FFFFFF" />

    <!-- Halo behind the app-name labels. The popup is fully transparent, so the labels
         render straight onto the wallpaper - and the theme tracks the Windows app theme,
         which says nothing about what is behind the window. ShadowDepth=0 makes this a
         symmetric outline rather than a directional shadow, so the text survives a
         wallpaper of the opposite brightness in either theme. Effects do not take part in
         measure/arrange, so tile sizing is untouched. -->
    <DropShadowEffect x:Key="LabelShadow" Color="#000000" BlurRadius="7" ShadowDepth="0" Opacity="1" />
</ResourceDictionary>
