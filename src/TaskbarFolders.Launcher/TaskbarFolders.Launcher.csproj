<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 1903 SDK projections unlock Windows.UI.Shell.TaskbarManager (used by the
         pin-mode pin runner). Manager and Shared stay on net8.0-windows. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskbarFolders.Launcher</RootNamespace>
    <AssemblyName>TaskbarFolders.Launcher</AssemblyName>
    <ApplicationIcon>..\..\assets\icons\manager.ico</ApplicationIcon>
    <Description>TaskbarFolders Launcher - Lightweight popup application for taskbar groups</Description>
    <!-- ReadyToRun: ahead-of-time compile to native code so cold-start skips the tiered-JIT
         warm-up (~100-300 ms). Especially valuable for the per-click short-lived launcher
         process where every ms before the popup paints is visible to the user. ZIP grows
         ~5-10 MB; acceptable for the launch-perf gain. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarFolders.Core\TaskbarFolders.Core.csproj" />
    <ProjectReference Include="..\TaskbarFolders.Shared\TaskbarFolders.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarFolders.Launcher.Tests" />
  </ItemGroup>

</Project>
