<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every key here must also exist in Dark.xaml. ThemeDictionaryTests asserts parity:
         a key defined in one theme and forgotten in the other resolves to nothing after a
         swap, and the control silently falls back to the Aero2 default. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F0F0F0" />
    <SolidColorBrush x:Key="DropZoneBackground" Color="#F5F5F5" />

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundDefault" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ForegroundSubtle" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#9A9A9A" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#E0E0E0" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentBrushHover" Color="#1A86D9" />
    <!-- Text on an accent fill. -->
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />

    <!-- Control chrome. WPF's built-in theme styles set Background and Foreground on
         Button/TextBox/ListBox/ComboBox/CheckBox, and a theme-style setter outranks the
         value the Window passes down by inheritance. Controls.xaml overrides them with
         explicit style setters built from these brushes. -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ControlBackgroundDisabled" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ControlBorder" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ControlBorderHover" Color="#A6A6A6" />
    <SolidColorBrush x:Key="TextBoxBackground" Color="#FFFFFF" />

    <!-- List selection -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#CCE4F7" />
    <SolidColorBrush x:Key="SelectionBackgroundInactive" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#EAEAEA" />

    <!-- The popup's tile, drawn by the preview on Appearance from Core's PopupTile.xaml: the
         same values as the Launcher's Light theme, so the preview looks like the popup. -->
    <SolidColorBrush x:Key="TileHoverBackground" Color="#1F0078D4" />
    <SolidColorBrush x:Key="TileFocusBorder" Color="#0067C0" />
    <DropShadowEffect x:Key="LabelShadow" Color="#FFFFFF" BlurRadius="7" ShadowDepth="0" Opacity="1" />
</ResourceDictionary>
