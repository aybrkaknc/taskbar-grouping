<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every key here must also exist in Light.xaml. ThemeDictionaryTests asserts parity:
         a key defined in one theme and forgotten in the other resolves to nothing after a
         swap, and the control silently falls back to the Aero2 default. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#252525" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#2D2D2D" />
    <SolidColorBrush x:Key="DropZoneBackground" Color="#2A2A2A" />

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundDefault" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ForegroundSubtle" Color="#A0A0A0" />
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#7A7A7A" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#3A3A3A" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentBrushHover" Color="#47B1E8" />
    <!-- Text on an accent fill: dark on the light dark-theme accent, as Windows does. -->
    <SolidColorBrush x:Key="AccentForeground" Color="#000000" />

    <!-- Control chrome. WPF's built-in theme styles set Background and Foreground on
         Button/TextBox/ListBox/ComboBox/CheckBox, and a theme-style setter outranks the
         value the Window passes down by inheritance. Controls.xaml overrides them with
         explicit style setters built from these brushes. -->
    <SolidColorBrush x:Key="ControlBackground" Color="#333333" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlBackgroundDisabled" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlBorderHover" Color="#5C5C5C" />
    <SolidColorBrush x:Key="TextBoxBackground" Color="#2B2B2B" />

    <!-- List selection -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#094771" />
    <SolidColorBrush x:Key="SelectionBackgroundInactive" Color="#37373D" />
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#2F2F2F" />
</ResourceDictionary>
