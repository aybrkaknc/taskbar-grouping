<Window x:Class="TaskbarFolders.Manager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskbarFolders.Manager.ViewModels"
        xmlns:models="clr-namespace:TaskbarFolders.Shared.Models;assembly=TaskbarFolders.Shared"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Width="480" Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundDefault}"
        TextElement.Foreground="{DynamicResource ForegroundDefault}">
    <Window.Resources>
        <ObjectDataProvider x:Key="ThemeValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ThemePreference" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="PopupPositionValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PopupPositionPreference" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel Margin="24">
        <!-- Every setting is applied and stored as it changes, so there is nothing to save. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" MinWidth="80" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <!-- Settings form -->
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox SelectedItem="{Binding Theme}"
                      ItemsSource="{Binding Source={StaticResource ThemeValues}}"
                      Margin="0,0,0,16" />

            <TextBlock Text="Popup position" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox SelectedItem="{Binding PopupPosition}"
                      ItemsSource="{Binding Source={StaticResource PopupPositionValues}}"
                      Margin="0,0,0,16" />

            <TextBlock Text="Popup backdrop" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.PopupBackdropOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding PopupBackdrop}"
                      AutomationProperties.Name="Popup backdrop"
                      ToolTip="What every popup is drawn on. A group can choose its own on Appearance."
                      Margin="0,0,0,16" />

            <CheckBox IsChecked="{Binding EnableAnimations}" Content="Enable popup animations" Margin="0,0,0,12" />
            <CheckBox IsChecked="{Binding AutoStart}" Content="Start TaskbarFolders Manager when Windows starts" Margin="0,0,0,12" />
            <CheckBox IsChecked="{Binding ShowInExplorerMenu}" Content="Show &quot;Taskbar Groups&quot; in Explorer's right-click menu" />

            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource ForegroundSubtle}" FontSize="11" TextWrapping="Wrap">
                Auto-start writes a per-user entry to
                HKCU\Software\Microsoft\Windows\CurrentVersion\Run — no administrator rights required.
            </TextBlock>

            <Separator Margin="0,16,0,12" />
            <TextBlock Text="Uninstall" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource ForegroundSubtle}" FontSize="11" TextWrapping="Wrap">
                Removes TaskbarFolders and everything it added to Windows — taskbar tiles, the Explorer
                menu, Start menu entries, your groups and settings. Asks before it starts.
            </TextBlock>
            <Button Content="Uninstall TaskbarFolders…" HorizontalAlignment="Left" Padding="12,4"
                    Command="{Binding UninstallCommand}" />

        </StackPanel>
    </DockPanel>
</Window>
