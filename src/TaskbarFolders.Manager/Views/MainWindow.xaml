<Window x:Class="TaskbarFolders.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskbarFolders.Manager.ViewModels"
        xmlns:icons="clr-namespace:TaskbarFolders.Core.Icons;assembly=TaskbarFolders.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="980" Height="640"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=GroupList}"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundDefault}"
        TextElement.Foreground="{DynamicResource ForegroundDefault}">
    <Window.Resources>
        <!-- One menu shared by every row. It opens on a row only, so a right-click on empty
             space no longer acts on whichever group happens to be selected. Its DataContext is
             the row's group; the window's view model reaches it through the row's Tag. -->
        <ContextMenu x:Key="GroupRowMenu">
            <MenuItem Header="Rename" InputGestureText="F2"
                      Command="{Binding PlacementTarget.Tag.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Delete group" InputGestureText="Del"
                      Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: group list, new-group and settings buttons -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <DockPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                <Button DockPanel.Dock="Right"
                        Content="+ New group"
                        Padding="10,4"
                        ToolTip="Creates a group and lets you name it right away."
                        Command="{Binding NewGroupCommand}" />
                <TextBlock Text="Groups" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}" Padding="6">
                <Button Style="{StaticResource SidebarFooterButton}"
                        ToolTip="Theme, popup position, start with Windows, uninstall"
                        Click="OpenSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <ListBox x:Name="GroupList"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}"
                     Padding="6,0"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource GroupRowMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding SelectedGroup}" />
                    <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" CommandParameter="{Binding SelectedGroup}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupListItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- A group with no icon file yet (no apps) shows a folder instead. -->
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSubtle}"
                                       Visibility="{Binding Icon, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="12,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AppCount}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSubtle}"
                                       ToolTip="{Binding AppCountText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Detail pane: drives off MainWindowViewModel.Editor -->
        <Grid Grid.Column="1" DataContext="{Binding Editor}">
            <!-- Empty-state placeholder shown when nothing is selected -->
            <TextBlock Text="Select a group to view details, or click + New group to create one."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundSubtle}"
                       Visibility="{Binding BoundItem, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />

            <!-- Editor content shown once a group is selected -->
            <DockPanel Margin="24"
                       Visibility="{Binding BoundItem, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}">
                <!-- Header: icon, name in place, app count; pin and the overflow menu on the right.
                     Rename, delete and the window-level commands live on MainWindowViewModel, so
                     those bindings reach past the Editor DataContext to the window's. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="GroupIconButton"
                            Style="{StaticResource SubtleButton}"
                            Padding="4"
                            ToolTip="The group's icon on the taskbar — click to change it"
                            Click="OpenOwnMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Change icon…" Click="ChooseGroupIcon_Click" />
                                <MenuItem Header="Use app icons" Command="{Binding ResetGroupIconCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource SurfaceMuted}">
                            <Image Source="{Binding CompositeIconPreview}" Margin="4" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>

                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <!-- Saved on Enter or when the box loses focus; Escape puts the name back. -->
                        <TextBox x:Name="GroupNameBox"
                                 Style="{StaticResource HeadingTextBox}"
                                 ToolTip="Group name — type to rename"
                                 Text="{Binding DataContext.EditedGroupName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="GroupName_KeyDown"
                                 LostKeyboardFocus="GroupName_LostKeyboardFocus" />
                        <TextBlock Text="{Binding BoundItem.AppCountText}" Margin="5,2,0,0"
                                   Foreground="{DynamicResource ForegroundSubtle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}"
                                Padding="14,6"
                                Command="{Binding PinToTaskbarCommand}"
                                ToolTip="Windows asks you to allow it. If your Windows does not allow apps to pin themselves, the shortcut folder opens instead: right-click the .lnk there and choose Pin to taskbar.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                                <TextBlock Text="Pin to taskbar" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton"
                                Style="{StaticResource SubtleButton}"
                                Margin="6,0,0,0"
                                ToolTip="More"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                Click="OpenOwnMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show shortcut…" Command="{Binding ShowShortcutCommand}" />
                                    <MenuItem Header="Copy group id" Click="CopyGroupId_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete group…"
                                              Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.Tag.SelectedGroup, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TabControl x:Name="EditorTabs">
                    <TabItem Header="Apps">
                        <!-- The whole tab takes dropped files; the outline appears only while
                             something is dragged over it. -->
                        <Grid x:Name="AppsTab"
                              Background="Transparent"
                              AllowDrop="True"
                              DragEnter="AppsTab_DragEnter"
                              DragLeave="AppsTab_DragLeave"
                              PreviewDragOver="Editor_PreviewDragOver"
                              Drop="Editor_Drop">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,8">
                                    <Button Padding="12,4" Click="AddAppPicker_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Add apps…" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundSubtle}"
                                               Text="or drop .exe and .lnk files here" />
                                </StackPanel>

                                <ListBox x:Name="AppList"
                                         ItemsSource="{Binding Apps}"
                                         ItemContainerStyle="{StaticResource ListRowItem}"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Delete"
                                                    Command="{Binding RemoveAppCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=AppList}" />
                                    </ListBox.InputBindings>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AppEntryViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                                                <!-- Icons load synchronously here, so a null icon means the app has none. -->
                                                <Viewbox Grid.Column="0" Width="32" Height="32">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Path Width="{x:Static icons:PlaceholderIcon.DesignSize}"
                                                          Height="{x:Static icons:PlaceholderIcon.DesignSize}"
                                                          Data="{x:Static icons:PlaceholderIcon.Shape}"
                                                          Stroke="{DynamicResource ForegroundSubtle}"
                                                          StrokeThickness="{x:Static icons:PlaceholderIcon.StrokeThickness}" />
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{DynamicResource ForegroundSubtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                </StackPanel>
                                                <!-- Shown for the row under the mouse or the selected one; Del removes
                                                     the selected app as well. Hidden, not collapsed, so rows keep their
                                                     width when it appears. -->
                                                <Button Grid.Column="2"
                                                        x:Name="RemoveButton"
                                                        Style="{StaticResource SubtleButton}"
                                                        Padding="8"
                                                        Visibility="Hidden"
                                                        ToolTip="Remove from the group (Del). The program itself is not touched."
                                                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                                                </Button>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border x:Name="DropOverlay"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Margin="0,8,0,0"
                                    CornerRadius="8"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Background="{DynamicResource DropZoneBackground}"
                                    Opacity="0.92">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                           Text="Drop to add to the group" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Appearance">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Group icon" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSubtle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Built from the icons of the group's first four apps." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                                <Setter Property="Text" Value="An image you chose. The apps you add or remove do not change it." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose image…" Padding="12,4" Click="ChooseGroupIcon_Click"
                                        ToolTip="Use an .ico, .png, .jpg or .bmp as the group's icon on the taskbar." />
                                <Button Content="Use app icons" Padding="12,4" Margin="8,0,0,0"
                                        Command="{Binding ResetGroupIconCommand}"
                                        ToolTip="Go back to the icon built from the group's apps. Available while an image is in use."
                                        ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
