<Window x:Class="TaskbarFolders.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskbarFolders.Manager.ViewModels"
        xmlns:icons="clr-namespace:TaskbarFolders.Core.Icons;assembly=TaskbarFolders.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="980" Height="640"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=GroupList}"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundDefault}"
        TextElement.Foreground="{DynamicResource ForegroundDefault}">
    <Window.Resources>
        <!-- One menu shared by every row. It opens on a row only, so a right-click on empty
             space no longer acts on whichever group happens to be selected. Its DataContext is
             the row's group; the window's view model reaches it through the row's Tag. -->
        <ContextMenu x:Key="GroupRowMenu">
            <MenuItem Header="Rename" InputGestureText="F2"
                      Command="{Binding PlacementTarget.Tag.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Delete group" InputGestureText="Del"
                      Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: group list, new-group and settings buttons -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <DockPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                <Button DockPanel.Dock="Right"
                        Content="+ New group"
                        Padding="10,4"
                        ToolTip="Creates a group and lets you name it right away."
                        Command="{Binding NewGroupCommand}" />
                <TextBlock Text="Groups" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}" Padding="6">
                <Button Style="{StaticResource SidebarFooterButton}"
                        ToolTip="Theme, popup position, start with Windows, uninstall"
                        Click="OpenSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <ListBox x:Name="GroupList"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}"
                     Padding="6,0"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource GroupRowMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding SelectedGroup}" />
                    <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" CommandParameter="{Binding SelectedGroup}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupListItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- A group with no icon file yet (no apps) shows a folder instead. -->
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSubtle}"
                                       Visibility="{Binding Icon, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="12,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AppCount}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSubtle}"
                                       ToolTip="{Binding AppCountText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Detail pane: drives off MainWindowViewModel.Editor -->
        <Grid Grid.Column="1" DataContext="{Binding Editor}">
            <!-- Empty-state placeholder shown when nothing is selected -->
            <TextBlock Text="Select a group to view details, or click + New group to create one."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundSubtle}"
                       Visibility="{Binding BoundItem, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />

            <!-- Editor content shown once a group is selected -->
            <DockPanel Margin="24"
                       Visibility="{Binding BoundItem, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}">
                <!-- Header: name + live composite preview -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Rename lives on MainWindowViewModel (it owns the sidebar order),
                             so these two bind past the Editor DataContext to the window's. -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Rename"
                                    Margin="8,0,16,0"
                                    Padding="12,4"
                                    VerticalAlignment="Center"
                                    ToolTip="Saves the name typed on the left. Change the name to enable this."
                                    ToolTipService.ShowOnDisabled="True"
                                    Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBox x:Name="GroupNameBox"
                                     FontSize="22" FontWeight="Light"
                                     Padding="4,2"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Group name — edit and press Enter to rename"
                                     Text="{Binding DataContext.EditedGroupName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="GroupName_KeyDown" />
                        </DockPanel>
                        <TextBlock Text="{Binding BoundItem.Id}" FontSize="11" Foreground="{DynamicResource ForegroundSubtle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Width="96" Height="96"
                                Background="{DynamicResource SurfaceMuted}"
                                CornerRadius="12">
                            <Image Source="{Binding CompositeIconPreview}"
                                   Stretch="Uniform" Margin="4" />
                        </Border>
                        <Button Content="Change icon..."
                                Margin="0,8,0,0" Padding="8,2"
                                ToolTip="Use an image (.ico, .png, .jpg, .bmp) as the group's icon instead of its apps' icons."
                                Click="ChooseGroupIcon_Click" />
                        <Button Content="Use app icons"
                                Margin="0,4,0,0" Padding="8,2"
                                ToolTip="Go back to the icon built from the group's first four apps. Available once an image was chosen."
                                ToolTipService.ShowOnDisabled="True"
                                Command="{Binding ResetGroupIconCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Drop zone hint + Add button -->
                <Border DockPanel.Dock="Top"
                        Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource DropZoneBackground}"
                        BorderBrush="{DynamicResource BorderEmphasis}" BorderThickness="1"
                        CornerRadius="8"
                        AllowDrop="True"
                        PreviewDragOver="Editor_PreviewDragOver"
                        Drop="Editor_Drop">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Add app..." Padding="12,4"
                                Click="AddAppPicker_Click" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSubtle}"
                                   Text="Drop .exe or .lnk files here, or use the button to browse." />
                    </DockPanel>
                </Border>

                <!-- Pin-to-taskbar helper: shows shortcut location in Explorer with inline guidance -->
                <Border DockPanel.Dock="Top"
                        Padding="12" Margin="0,0,0,12"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Pin to taskbar"
                                    Padding="12,4"
                                    Command="{Binding PinToTaskbarCommand}" />
                            <Button Content="Show shortcut..."
                                    Padding="12,4"
                                    Margin="8,0,0,0"
                                    Command="{Binding ShowShortcutCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSubtle}" VerticalAlignment="Center">
                            <Run Text="Pin to taskbar:" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="One click — Windows will ask you to allow it. If your build does not support direct pinning, use Show shortcut and right-click the .lnk." />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- App list -->
                <ListBox ItemsSource="{Binding Apps}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppEntryViewModel}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                                <!-- Icons load synchronously here, so a null icon means the app has none. -->
                                <Viewbox Grid.Column="0" Width="32" Height="32">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Path Width="{x:Static icons:PlaceholderIcon.DesignSize}"
                                          Height="{x:Static icons:PlaceholderIcon.DesignSize}"
                                          Data="{x:Static icons:PlaceholderIcon.Shape}"
                                          Stroke="{DynamicResource ForegroundSubtle}"
                                          StrokeThickness="{x:Static icons:PlaceholderIcon.StrokeThickness}" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{DynamicResource ForegroundSubtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="Remove" Padding="8,2"
                                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
