<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:TaskbarFolders.Core.Icons">
    <!-- The popup's tile, defined once: the Launcher's popup and the Manager's preview both
         merge this dictionary, so the preview cannot drift from what the popup draws.

         Colours are dynamic resources each app's theme defines (ForegroundDefault,
         ForegroundSubtle, TileHoverBackground, TileFocusBorder, LabelShadow); a key missing from
         one theme draws nothing in exactly that theme, which PopupTileResourcesTests pins.

         PopupTileContent binds by name, not by type: to the item's Icon, IconMissing and Name,
         and to Tile (TileMetrics) and ShowNames on the DataContext of the ItemsControl that
         holds it. Whatever shows tiles provides those names. -->

    <BooleanToVisibilityConverter x:Key="PopupTileVisibility" />

    <!-- Drawn only when the focus arrived from the keyboard (WPF shows a FocusVisualStyle
         for keyboard focus, not for a click), so opening the popup with the mouse puts no
         ring on the first tile even though it holds the focus. -->
    <Style x:Key="AppTileFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource TileFocusBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppTileButton" TargetType="Button">
        <!-- Required, not redundant: WPF's built-in Button theme style sets Foreground to
             the system control-text colour (black), and a theme-style setter outranks the
             ForegroundDefault inherited from the window. Without this the labels were
             black in both themes. Pinned by PopupWindowThemeTests. -->
        <Setter Property="Foreground" Value="{DynamicResource ForegroundDefault}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- TileMetrics assumes this padding (its Padding constant). -->
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppTileFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileHoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What a tile shows: the icon (or the placeholder when IconMissing), and the name under it
         when the group shows names. Sized by TileMetrics through the ItemsControl's Tile. -->
    <DataTemplate x:Key="PopupTileContent">
        <StackPanel>
            <Grid Width="{Binding DataContext.Tile.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  Height="{Binding DataContext.Tile.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Image Source="{Binding Icon}" Stretch="Uniform" />
                <Viewbox Visibility="{Binding IconMissing, Converter={StaticResource PopupTileVisibility}}">
                    <Path Width="{x:Static icons:PlaceholderIcon.DesignSize}"
                          Height="{x:Static icons:PlaceholderIcon.DesignSize}"
                          Data="{x:Static icons:PlaceholderIcon.Shape}"
                          Stroke="{DynamicResource ForegroundSubtle}"
                          StrokeThickness="{x:Static icons:PlaceholderIcon.StrokeThickness}" />
                </Viewbox>
            </Grid>
            <TextBlock Text="{Binding Name}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="{Binding DataContext.Tile.LabelMaxWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Visibility="{Binding DataContext.ShowNames, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource PopupTileVisibility}}"
                       Effect="{DynamicResource LabelShadow}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
